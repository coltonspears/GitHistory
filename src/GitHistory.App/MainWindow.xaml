                        <ui:SearchBox Text="{Binding Import.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Placeholder="Search discovered repositories…" MinHeight="34" AutomationProperties.Name="Search import repositories"/>
                    </DockPanel>
                    <Grid Grid.Row="3" MinHeight="140" MaxHeight="300">
                        <ListBox ItemsSource="{Binding Import.VisibleRepositories}" Background="{DynamicResource ElevatedBrush}" BorderBrush="{DynamicResource LineBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Discovered repositories">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="8,9"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalContentAlignment="Stretch">
                                        <DockPanel Margin="7,0,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="Private" FontSize="9" Foreground="{DynamicResource AccentBrush}" Margin="12,0" Visibility="{Binding Repository.IsPrivate, Converter={StaticResource BoolVisibility}}"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Repository.FullName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Repository.CloneUrl}" Foreground="{DynamicResource QuietBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Discover repositories to choose what to import." Foreground="{DynamicResource QuietBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Import.VisibleRepositories.Count, Converter={StaticResource EmptyVisibility}}"/>
                        <Border Background="{DynamicResource SurfaceBrush}" Opacity="0.97" Visibility="{Binding Import.IsBusy, Converter={StaticResource BoolVisibility}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                <ui:BusyIndicator Content="Loading repositories…"/>
                                <TextBlock Text="{Binding Import.Status}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="4" Margin="0,13,0,0">
                        <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" Visibility="{Binding Import.Error, Converter={StaticResource NonEmptyVisibility}}">
                            <TextBlock Text="{Binding Import.Error}" Foreground="{DynamicResource DeletedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        </ScrollViewer>
                        <TextBlock Text="{Binding Import.Status}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <DockPanel>
                            <Button Content="Cancel loading" Command="{Binding Import.CancelCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Visibility="{Binding Import.IsBusy, Converter={StaticResource BoolVisibility}}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Close" Command="{Binding Import.CloseCommand}" Style="{StaticResource ActionButton}" Margin="0,0,10,0"/>
                                <Button Content="Import selected" Command="{Binding Import.ImportSelectedCommand}" Style="{StaticResource PrimaryButton}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsPaletteOpen, Converter={StaticResource BoolVisibility}}" KeyboardNavigation.TabNavigation="Cycle">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Width="590" MaxHeight="590" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,110,0,0" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Content="Esc" Style="{StaticResource QuietButton}" Command="{Binding ClosePaletteCommand}" MinHeight="24" Padding="5,1"/>
                        <TextBlock Text="Command palette" Style="{StaticResource Eyebrow}"/>
                    </DockPanel>
                    <ui:SearchBox Grid.Row="1" Text="{Binding PaletteSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Placeholder="Find a command or switch repositories…" MinHeight="42" FontSize="14" b:FocusBehavior.FocusWhenVisible="True" b:FocusBehavior.NextTarget="{Binding ElementName=PaletteList}" AutomationProperties.Name="Search commands">
                        <ui:SearchBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ExecutePaletteCommand}"/>
                        </ui:SearchBox.InputBindings>
                    </ui:SearchBox>
                    <ListBox x:Name="PaletteList" Grid.Row="2" ItemsSource="{Binding PaletteItems}" SelectedItem="{Binding SelectedPaletteItem, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Margin="0,12,0,0" MaxHeight="355" ScrollViewer.HorizontalScrollBarVisibility="Disabled" b:CommandBehavior.DoubleClickCommand="{Binding ExecutePaletteCommand}" AutomationProperties.Name="Available commands">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ExecutePaletteCommand}"/>
                        </ListBox.InputBindings>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="10,11"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Key, Converter={StaticResource PaletteShortcut}}" Style="{StaticResource Mono}" FontSize="10" Margin="16,0,0,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="3" Text="↑ ↓ to navigate     Enter to run     Esc to dismiss" Foreground="{DynamicResource QuietBrush}" FontSize="10" Margin="10,14,0,0"/>
                </Grid>
            </Border>
        </Grid>
        <Border Background="{DynamicResource CanvasBrush}" Opacity="0.98" Visibility="{Binding IsInitializing, Converter={StaticResource BoolVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:BusyIndicator Content="Loading GitHistory…"/>
                <TextBlock Text="Restoring your workspace and preferences" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,12"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
