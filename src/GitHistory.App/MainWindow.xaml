<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:GitHistory.UI.Controls;assembly=GitHistory.UI" xmlns:b="clr-namespace:GitHistory.App.Behaviors" xmlns:uib="clr-namespace:GitHistory.UI.Behaviors;assembly=GitHistory.UI" x:Class="GitHistory.App.MainWindow" Title="GitHistory" Icon="{StaticResource BranchIcon}" Width="1500" Height="940" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True" b:FocusBehavior.SearchTarget="{Binding ElementName=FileSearch}">
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="K" Command="{Binding OpenPaletteCommand}"/>
        <KeyBinding Modifiers="Control" Key="R" Command="{Binding Workspace.RefreshCommand}"/>
        <KeyBinding Key="F5" Command="{Binding Workspace.RefreshCommand}"/>
        <KeyBinding Modifiers="Control" Key="D" Command="{Binding ToggleThemeCommand}"/>
        <KeyBinding Modifiers="Control" Key="B" Command="{x:Static ui:Sidebar.ToggleCommand}" CommandTarget="{Binding ElementName=WorkspaceSidebar}"/>
        <KeyBinding Key="Escape" Command="{Binding ClosePaletteCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate x:Key="ChangeBadgeTemplate">
            <Border Style="{StaticResource ChangeBadge}" Margin="0,5">
                <TextBlock Text="{Binding ChangeType}" Style="{StaticResource ChangeLabel}"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="DiffMarkerTemplate">
            <TextBlock Text="{Binding Marker}" Style="{StaticResource Mono}" Margin="5,0"/>
        </DataTemplate>
        <DataTemplate x:Key="DiffTextTemplate">
            <Border Padding="6,2" MinHeight="23">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Added">
                                <Setter Property="Background" Value="{DynamicResource AddedBackgroundBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Deleted">
                                <Setter Property="Background" Value="{DynamicResource DeletedBackgroundBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Header">
                                <Setter Property="Background" Value="{DynamicResource DiffHeaderBackgroundBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Notice">
                                <Setter Property="Background" Value="{DynamicResource ModifiedBackgroundBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Text}" FontFamily="Cascadia Code, Consolas" FontSize="12" TextWrapping="NoWrap" ToolTipService.InitialShowDelay="500" ToolTipService.ShowDuration="120000">
                    <TextBlock.ToolTip>
                        <ToolTip MaxWidth="820" MaxHeight="330" Padding="12" StaysOpen="True" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}">
                            <StackPanel>
                                <TextBlock Text="Full line · select text to copy" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinWidth="320" MaxWidth="780" MaxHeight="275" Padding="4" BorderThickness="0" FontFamily="Cascadia Code, Consolas" FontSize="12" Focusable="True" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="Complete diff line; select and copy text"/>
                            </StackPanel>
                        </ToolTip>
                    </TextBlock.ToolTip>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Added">
                                    <Setter Property="Foreground" Value="{DynamicResource AddedBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Deleted">
                                    <Setter Property="Foreground" Value="{DynamicResource DeletedBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Header">
                                    <Setter Property="Foreground" Value="{DynamicResource DiffHeaderBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid x:Name="WorkspaceContent">
            <Grid.IsEnabled>
                <MultiBinding Converter="{StaticResource NoModalOpen}">
                    <Binding Path="IsPaletteOpen"/>
                    <Binding Path="Workspace.IsConnectOpen"/>
                    <Binding Path="Settings.IsOpen"/>
                    <Binding Path="Import.IsOpen"/>
                </MultiBinding>
            </Grid.IsEnabled>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Margin="0,0,11,0">
                            <Image Width="23" Height="23" Source="{StaticResource BranchIcon}"/>
                        </Border>
                        <TextBlock Text="GitHistory" FontSize="21" FontWeight="SemiBold"/>
                        <Border Width="1" Height="18" Background="{DynamicResource LineBrush}" Margin="23,0"/>
                        <TextBlock Text="Follow the change." FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="LayoutPicker" Width="142" Margin="0,0,14,0" ItemsSource="{x:Static ui:WorkspaceLayout.Presets}"
                                  DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Layout, ElementName=WorkspaceDock, Mode=TwoWay}"
                                  ToolTip="Workspace layout" AutomationProperties.Name="Workspace layout"/>
                        <Button Style="{StaticResource QuietButton}" Command="{Binding OpenPaletteCommand}" Content="Commands    Ctrl K" ToolTip="Open command palette (Ctrl+K)" AutomationProperties.Name="Open command palette"/>
                        <Button Style="{StaticResource ActionButton}" Command="{Binding OpenImportCommand}" Content="Import repositories" Margin="12,0,0,0"/>
                        <Button Style="{StaticResource PrimaryButton}" x:Name="ConnectRepositoryButton" Command="{Binding Workspace.OpenConnectCommand}" Content="＋  Connect repository" Margin="15,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ui:Sidebar x:Name="WorkspaceSidebar" Grid.Row="1" Header="Repository explorer" ExpandedWidth="252">
                <Grid Margin="13,5,13,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <DockPanel Margin="6,0,3,10">
                            <TextBlock Text="Workspaces" Style="{StaticResource Eyebrow}"/>
                            <CheckBox Content="Pinned" IsChecked="{Binding Workspace.ShowOnlyPinned}" HorizontalAlignment="Right" FontSize="11" ToolTip="Show favorite repositories only"/>
                        </DockPanel>
                        <ui:SearchBox Text="{Binding Workspace.RepositorySearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Placeholder="Find a workspace…" Margin="0,0,0,7" AutomationProperties.Name="Search workspaces"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <ListBox x:Name="RepositoryNavigator" ItemsSource="{Binding Workspace.VisibleRepositories, NotifyOnTargetUpdated=True}" SelectedItem="{Binding Workspace.SelectedRepository, Mode=OneWay}" b:ExplicitSelectionBehavior.SelectionCommand="{Binding Workspace.SelectRepositoryCommand}" Background="Transparent" BorderThickness="0" MaxHeight="190" AutomationProperties.Name="Saved repositories">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,5" ToolTip="{Binding RemoteUrl}">
                                        <Image Width="15" Height="15" Source="{StaticResource RepositoryIcon}" Margin="0,0,8,0"/>
                                        <TextBlock DockPanel.Dock="Right" Text="Demo" FontSize="9" Foreground="{DynamicResource AccentBrush}" Margin="5,0,0,0" Visibility="{Binding IsDemo, Converter={StaticResource BoolVisibility}}"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="No matching workspaces" FontSize="11" Foreground="{DynamicResource QuietBrush}" Margin="7,8" Visibility="{Binding Workspace.VisibleRepositories.Count, Converter={StaticResource EmptyVisibility}}"/>
                        <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="5" Padding="10,8" Margin="0,9,0,0">
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Open source control page" Command="{Binding Actions.OpenRepositoryBrowserCommand}"/>
                                    <MenuItem Header="Copy remote URL" Command="{Binding Actions.CopyRemoteUrlCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Open checkout in Explorer" Command="{Binding Actions.OpenExplorerCommand}"/>
                                    <MenuItem Header="Open checkout in Cursor" Command="{Binding Actions.OpenCursorCommand}"/>
                                    <MenuItem Header="Link local checkout…" Command="{Binding Actions.LinkLocalFolderCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Pin / unpin workspace" Command="{Binding Workspace.TogglePinCommand}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding Workspace.TogglePinCommand}" Padding="5,2" MinHeight="26" ToolTip="Pin or unpin the active workspace" AutomationProperties.Name="Pin active workspace">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                            <Setter Property="Content" Value="☆"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Workspace.SelectedIsPinned}" Value="True">
                                                    <Setter Property="Content" Value="★"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="Active workspace" FontSize="9" Foreground="{DynamicResource QuietBrush}"/>
                                    <TextBlock Text="{Binding Workspace.SelectedRepository.Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding Workspace.SelectedRepository.RemoteUrl}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,16,0,7">
                        <DockPanel Margin="6,0,2,9">
                            <TextBlock Text="Folders" Style="{StaticResource Eyebrow}"/>
                            <Button Content="Clear filters" Command="{Binding Browser.ClearFiltersCommand}" Style="{StaticResource QuietButton}" MinHeight="20" Padding="3,0" FontSize="10" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <ui:SearchBox Text="{Binding Browser.FolderSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Placeholder="Find a folder…" AutomationProperties.Name="Search workspace folders"/>
                    </StackPanel>
                    <TreeView Grid.Row="3" x:Name="FolderTree" ItemsSource="{Binding Browser.VisibleTreeNodes, Converter={StaticResource FolderHierarchy}, NotifyOnTargetUpdated=True}" b:ExplicitSelectionBehavior.SelectedItem="{Binding Browser.SelectedNode, Mode=OneWay}" b:ExplicitSelectionBehavior.SelectionCommand="{Binding Browser.SelectFolderCommand}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Filter files by folder" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="Padding" Value="2,2"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <DockPanel Margin="2,5" ToolTip="{Binding Node.Path}">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Node.Count}" Width="22" TextAlignment="Right" Foreground="{DynamicResource QuietBrush}" FontSize="10" Margin="8,0,3,0"/>
                                    <Image Source="{StaticResource FolderIcon}" Width="13" Height="13" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding Node.Name}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <StackPanel Grid.Row="4">
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,7"/>
                        <Button Style="{StaticResource QuietButton}" Content="↗  Source control page" HorizontalContentAlignment="Left" Command="{Binding Actions.OpenRepositoryBrowserCommand}"/>
                        <Button Style="{StaticResource QuietButton}" Content="⚙  Settings" HorizontalContentAlignment="Left" Command="{Binding OpenSettingsCommand}"/>
                    </StackPanel>
                </Grid>
            </ui:Sidebar>
            <Grid Grid.Row="1" Grid.Column="1" Margin="22,20,22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Browser.Heading}" FontSize="25" FontWeight="SemiBold"/>
                            <Border CornerRadius="4" Background="{DynamicResource AccentSoftBrush}" Padding="7,3" Margin="12,2,0,0" VerticalAlignment="Center" Visibility="{Binding Workspace.IsDemo, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="Demo" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Browser.Subtitle}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Branch" Style="{StaticResource Eyebrow}" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding Workspace.Branches}" SelectedItem="{Binding Workspace.SelectedBranch, Mode=TwoWay}" IsEditable="False" Width="165" MinHeight="34" AutomationProperties.Name="Branch"/>
                        <Button Style="{StaticResource ActionButton}" Command="{Binding Workspace.RefreshCommand}" Content="Refresh" Margin="10,0,0,0" ToolTip="Fetch latest changes (F5)"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="19,13" Margin="0,0,0,13" >
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource MinimumHeightVisibility}" ConverterParameter="800">
                            <Binding Path="Settings.ShowActivityChart"/>
                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </Border.Visibility>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Browser.FilesCount, StringFormat=N0}" FontSize="29" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="files in view" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Browser.CommitCount, StringFormat=N0}" FontSize="29" FontWeight="SemiBold"/>
                            <TextBlock Text="commits" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Browser.ContributorCount, StringFormat=N0}" FontSize="29" FontWeight="SemiBold"/>
                            <TextBlock Text="contributors" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Grid Grid.Column="3" Margin="17,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="52"/>
                                <RowDefinition Height="22"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="Branch activity" Style="{StaticResource Eyebrow}"/>
                                <TextBlock Text="{Binding Browser.Activity, Converter={StaticResource ActivityExtent}}" FontSize="10" Foreground="{DynamicResource QuietBrush}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <ui:ActivityChart x:Name="ActivityChart" Grid.Row="1" Grid.RowSpan="2" ItemsSource="{Binding Browser.Activity}" DateMemberPath="Date" ValueMemberPath="Files" SelectedItem="{Binding Browser.SelectedActivity, Mode=TwoWay}" RangeStart="{Binding Browser.RangeStart, Mode=TwoWay}" RangeEnd="{Binding Browser.RangeEnd, Mode=TwoWay}" AutomationProperties.Name="Branch activity; click a day or drag a date range"/>
                        </Grid>
                    </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="135"/>
                    </Grid.ColumnDefinitions>
                    <ui:SearchBox x:Name="FileSearch" Text="{Binding Browser.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Placeholder="Search files, paths, or commit messages…   Ctrl F" Margin="0,0,10,0" AutomationProperties.Name="Search files paths or commit messages"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Browser.Authors}" SelectedItem="{Binding Browser.SelectedAuthor, Mode=TwoWay}" IsEditable="False" MinHeight="34" Margin="0,0,10,0" AutomationProperties.Name="Author filter"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding Browser.DatePresets}" SelectedItem="{Binding Browser.DatePreset, Mode=TwoWay}" IsEditable="False" MinHeight="34" AutomationProperties.Name="Date range preset"/>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Right" Margin="0,10,0,0" Orientation="Horizontal" Visibility="{Binding Browser.IsCustomRange, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="Date range" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                        <DatePicker SelectedDate="{Binding Browser.FromDate, Mode=TwoWay}" Width="120" MinHeight="34" Margin="10,0,0,0" AutomationProperties.Name="From date"/>
                        <TextBlock Text="–" Margin="6,0" Foreground="{DynamicResource MutedBrush}"/>
                        <DatePicker SelectedDate="{Binding Browser.UntilDate, Mode=TwoWay}" Width="120" MinHeight="34" AutomationProperties.Name="Until date inclusive"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="3">
                    <Border Background="{DynamicResource ModifiedBackgroundBrush}" CornerRadius="5" Padding="12,9" Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Browser.QueryError}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding Browser.QueryError}" Foreground="{DynamicResource ModifiedBrush}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                    <Border Background="{DynamicResource DeletedBackgroundBrush}" BorderBrush="{DynamicResource DeletedBrush}" BorderThickness="1" CornerRadius="5" Padding="12,9" Margin="0,0,0,10" Visibility="{Binding Workspace.HasError, Converter={StaticResource BoolVisibility}}">
                        <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding Workspace.Error}" Foreground="{DynamicResource DeletedBrush}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                    <Border Background="{DynamicResource DeletedBackgroundBrush}" CornerRadius="5" Padding="12,8" Margin="0,0,0,10" Visibility="{Binding Actions.Error, Converter={StaticResource NonEmptyVisibility}}">
                        <TextBlock Text="{Binding Actions.Error}" TextWrapping="Wrap" Foreground="{DynamicResource DeletedBrush}"/>
                    </Border>
                    <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="5" Padding="12,8" Margin="0,0,0,10" Visibility="{Binding Workspace.IsBusy, Converter={StaticResource BoolVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="Cancel" Command="{Binding Workspace.RefreshCancelCommand}" MinHeight="25" Padding="8,2"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Workspace.ProgressText}" FontSize="12" Margin="0,0,0,6"/>
                                <ProgressBar IsIndeterminate="True" Height="3" BorderThickness="0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
                <ui:WorkspaceLayout x:Name="WorkspaceDock" Grid.Row="4" Background="{DynamicResource CanvasBrush}">
                    <Border x:Name="FilesPanel" ui:WorkspaceLayout.Region="Primary" CornerRadius="8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ClipToBounds="True">
                        <Grid Background="{DynamicResource SurfaceBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="43"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,1,1,0" Background="{DynamicResource SurfaceBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Recent changes" GroupName="FileMode" Style="{StaticResource ViewTab}" IsChecked="{Binding Browser.Mode, Mode=TwoWay, Converter={StaticResource EnumSelection}, ConverterParameter=RecentChanges}"/>
                                        <RadioButton Content="All files" GroupName="FileMode" Style="{StaticResource ViewTab}" IsChecked="{Binding Browser.Mode, Mode=TwoWay, Converter={StaticResource EnumSelection}, ConverterParameter=AllFiles}"/>
                                    </StackPanel>
                                    <DockPanel Grid.Column="1" Margin="12,0" HorizontalAlignment="Right">
                                        <Image Source="{StaticResource FolderIcon}" Width="13" Height="13" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding Browser.FolderLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}" MaxWidth="350" TextTrimming="CharacterEllipsis" ToolTip="{Binding Browser.FolderLabel}"/>
                                    </DockPanel>
                                </Grid>
                            </Border>
                            <DataGrid RowHeight="40" uib:DataGridOptions.IsEnabled="True" x:Name="FilesGrid" Grid.Row="1" ItemsSource="{Binding Browser.Files}" SelectedItem="{Binding Browser.SelectedFile, Mode=TwoWay}" Tag="{Binding}" b:RowContextBehavior.SelectOnRightClick="True" AutoGenerateColumns="False" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource SurfaceBrush}" AutomationProperties.Name="Files ordered by last change">
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="6,5"/></Style>
                                </DataGrid.CellStyle>
                                <DataGrid.GroupStyle><GroupStyle HeaderTemplate="{StaticResource GridGroupHeader}"/></DataGrid.GroupStyle>
                                <DataGrid.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="View file in browser" Command="{Binding Actions.OpenFileBrowserCommand}" CommandParameter="{Binding Browser.SelectedFile}"/>
                                        <Separator/>
                                        <MenuItem Header="Open in Explorer" Command="{Binding Actions.OpenExplorerCommand}" CommandParameter="{Binding Browser.SelectedFile}"/>
                                        <MenuItem Header="Open in Cursor" Command="{Binding Actions.OpenCursorCommand}" CommandParameter="{Binding Browser.SelectedFile}"/>
                                        <MenuItem Header="Copy path" Command="{Binding Actions.CopyPathCommand}" CommandParameter="{Binding Browser.SelectedFile}"/>
                                        <Separator/>
                                        <MenuItem Header="Link local checkout…" Command="{Binding Actions.LinkLocalFolderCommand}"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="File" Width="1.1*" SortMemberPath="Path" MinWidth="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Margin="8,0" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Folder" Width="1.1*" SortMemberPath="Folder" MinWidth="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="7,0" VerticalAlignment="Center" ToolTip="{Binding Path}">
                                                    <Image Source="{StaticResource FolderIcon}" Width="13" Height="13" Margin="0,0,7,0"/>
                                                    <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Change" Width="88" MinWidth="88" SortMemberPath="ChangeType" CellTemplate="{StaticResource ChangeBadgeTemplate}"/>
                                    <DataGridTemplateColumn Header="Last changed" Width="110" MinWidth="110" SortMemberPath="LastChanged">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Age}" Margin="5,0" VerticalAlignment="Center" ToolTip="{Binding LastChanged, StringFormat=F}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Age}" Value="Today">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Age}" Value="Yesterday">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Author" Width="130" MinWidth="120" SortMemberPath="Author" Binding="{Binding Author}"/>
                                    <DataGridTextColumn Header="Latest commit" Width="*" SortMemberPath="Subject" MinWidth="180" Binding="{Binding Subject}"/>
                                    <DataGridTextColumn Header="Touches" Width="75" MinWidth="75" SortMemberPath="TouchCount" Binding="{Binding TouchCount}"/>
