                                                                <TextBlock Text="{Binding Number, StringFormat='#{0}'}" Foreground="{DynamicResource AccentBrush}" FontSize="11"/>
                                                                <TextBlock Text="{Binding State}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="10,0"/>
                                                                <TextBlock Text="{Binding Author}" Foreground="{DynamicResource QuietBrush}" FontSize="11"/>
